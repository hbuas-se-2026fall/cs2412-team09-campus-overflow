# 复制本文件为 deploy/.env 后填写真实值；.env 已被 .gitignore 忽略，不要提交。
# 仅公网 / 校园网部署需要（配合 docker-compose.prod.yml）。本地演示可以不建这个文件。

# MySQL root 密码：换掉默认值，建议 16 位以上随机串
MYSQL_ROOT_PASSWORD=

# 应用连接数据库用的密码（MYSQL_USER=campus 的密码）
DB_PASSWORD=

# 敏感字段加密密钥（AES-256-GCM，Base64 编码的 32 字节）
# 生成方式：openssl rand -base64 32
# 注意：更换此密钥后，已加密的邮箱等字段无法解密，需评估后再改
CO_FIELD_KEY=

# Grafana 管理员密码
GRAFANA_PASSWORD=
