# 公网部署的环境变量样板。复制成 .env.public 后填值，不要提交真实值。
#   cp deploy/.env.public.example deploy/.env.public
#   chmod 600 deploy/.env.public
#
# 生成随机值的方式（任选其一）：
#   openssl rand -base64 32
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# 注意：CO_FIELD_KEY 是字段加密密钥（32 字节的 Base64）。
# 一旦有数据写入就不能随意更换，否则历史密文字段无法解密。

# 数据库
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Redis（公网部署必须设置，容器启动时用 --requirepass 注入）
REDIS_PASSWORD=

# 字段加密密钥（32 字节 Base64）
CO_FIELD_KEY=

# Grafana 管理员口令（observability profile 才需要）
GRAFANA_PASSWORD=
